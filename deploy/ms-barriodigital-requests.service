[Unit]
Description=BarrioDigital - Microservicio de Tramites
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/barriodigital/requests
ExecStart=/usr/bin/java -jar /opt/barriodigital/requests/app.jar

# TODO-CONFIG: reemplazar los valores antes de copiar este archivo a la EC2.
Environment=ORACLE_DB_URL=TODO-CONFIG
Environment=ORACLE_DB_USER=TODO-CONFIG
Environment=ORACLE_DB_PASSWORD=TODO-CONFIG

Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
